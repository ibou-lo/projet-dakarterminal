{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/inject-api-base.js && npm run build",
  "outputDirectory": "dist/dakar-autotrack-web/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "${API_BASE_URL}/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
